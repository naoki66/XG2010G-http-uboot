loadaddr=0x81800000
bootconf=config-1
recovery_trigger=0
bootargs=sdram_conf=0x00108893 vendor_name=ECONET Technologies Corp. product_name=xPON ONU ubi.mtd=system ethaddr=00:AA:BB:01:23:40 snmp_sysobjid=1.2.3.4.5 country_code=ff ether_gpio=0c power_gpio=1515 dsl_gpio=0b internet_gpio=02 multi_upgrade_gpio=0b020400000000000000000000000000 onu_type=62 qdma_init=69bb console=ttyS0,115200n8 earlycon bootflag=0 serdes_sel=0 serdes_pon=000 serdes_ethernet=411 serdes_wifi1=005 serdes_wifi2=413 serdes_usb1=111 serdes_usb2=000 tclinux_info=0x1fc4d8b,0x5724,0x36101e,0x366840,0x1c60000,0x0,0x2000,0x0,0x2000,0x0 ubi.block=0,fit root=/dev/fit0 rootwait ramdisk_size=65536 rdinit=/sbin/init
boot_ubi=ubi part system && run boot_production
boot_production=run ubi_read_production && bootm ${loadaddr}#${bootconf}
bootcmd=run boot_ubi || http_recovery
ubi_read_production=ubi read ${loadaddr} fit
recovery_addr=0x81800000
recovery_mtd=fit
recovery_ubi_part=system
recovery_dev_uboot=spi-nand0
uboot_ofs=0x600000
recovery_size_uboot=0x100000
rtl8261_patch_autoload=1
