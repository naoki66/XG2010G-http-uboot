/dts-v1/;

/ {
	description = "XG2010G chainloader FIT";
	#address-cells = <1>;

	images {
		fdt@1 {
			description = "XG2010G chainloader control DTB";
			data = /incbin/("__DTB__");
			type = "flat_dt";
			arch = "arm64";
			compression = "none";
			hash@1 {
				algo = "sha1";
			};
		};
		kernel@1 {
			description = "XG2010G secondary U-Boot (full chainloader payload)";
			data = /incbin/("__PAYLOAD__");
			type = "kernel";
			arch = "arm64";
			os = "linux";
			compression = "none";
			load = <0x81e00000>;
			entry = <0x81e00000>;
			hash@1 {
				algo = "sha1";
			};
		};
	};

	configurations {
		default = "config@1";
		config@1 {
			description = "XG2010G chainloader";
			kernel = "kernel@1";
			fdt = "fdt@1";
		};
	};
};
